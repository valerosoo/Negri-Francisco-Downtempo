# Copiá este archivo como ".env" y ajustá los valores. Todos son opcionales:
# si no hay .env se usan estos mismos valores por defecto.

# Puerto del servidor
PORT=3000

# Archivo donde se guardan los datos (relativo a backend/)
DB_FILE=data/db.json

# Clave del panel de administración (/admin en el frontend)
ADMIN_KEY=downtempo-admin

# Origen permitido por CORS ("*" = cualquiera)
CORS_ORIGIN=*
